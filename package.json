{
  "name": "tracehound",
  "version": "1.6.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm --filter @tracehound/core build",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "test:chaos": "tsx scripts/chaos/run-chaos-suite.ts",
    "verify:release": "node scripts/release/verify-publish-packages.mjs",
    "validate:paranoid": "pnpm lint && pnpm build && pnpm test && pnpm test:coverage && pnpm test:chaos && node scripts/release/verify-publish-packages.mjs",
    "review:branch": "node scripts/review/pr-branch-review.mjs",
    "prelint": "pnpm --filter @tracehound/core build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@tracehound/core": "workspace:^",
    "@tracehound/express": "workspace:^",
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^2.0.0",
    "express": "^4.18.2",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.1",
      "esbuild": ">=0.25.0"
    }
  }
}
