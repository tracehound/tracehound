{
  "name": "tracehound",
  "version": "1.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "test:chaos": "tsx scripts/chaos/run-chaos-suite.ts",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "assurance:report": "node scripts/generate-fuzz-assurance-report.mjs --mode assurance --output security/artifacts/generated/fuzz-assurance-metrics.json",
    "assurance:report:regression": "node scripts/generate-fuzz-assurance-report.mjs --mode regression --output security/artifacts/generated/fuzz-regression-metrics.json",
    "assurance:lifecycle:init": "node scripts/record-fuzz-failure.mjs --init",
    "assurance:lifecycle:record": "node scripts/record-fuzz-failure.mjs --record",
    "assurance:gate": "node scripts/generate-fuzz-assurance-report.mjs --mode assurance --output security/artifacts/generated/fuzz-assurance-metrics.json --enforce-pass",
    "assurance:gate:regression": "node scripts/generate-fuzz-assurance-report.mjs --mode regression --output security/artifacts/generated/fuzz-regression-metrics.json --enforce-pass"
  },
  "devDependencies": {
    "@tracehound/core": "workspace:^",
    "@tracehound/express": "workspace:^",
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^2.0.0",
    "express": "^4.18.2",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.1.4"
}
