{
  "name": "tracehound",
  "version": "1.8.9",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm --filter @tracehound/core build",
    "test": "pnpm -r test",
    "test:fuzz:regression": "vitest run packages/core/tests/fuzz",
    "test:coverage": "vitest run --coverage",
    "test:chaos": "pnpm build && pnpm --filter tracehound-chaos-testing test",
    "test:forensic-lab": "pnpm --filter tracehound-forensic-lab build && node infrastructure/forensic-lab/dist/main.js",
    "verify:release": "node scripts/release/verify-publish-packages.mjs",
    "verify:release-boundary": "node scripts/release/verify-publish-packages.mjs",
    "validate:all": "pnpm lint && pnpm format && pnpm build && pnpm test && pnpm test:fuzz:regression && pnpm test:coverage && pnpm test:chaos && pnpm test:forensic-lab && node scripts/release/verify-publish-packages.mjs",
    "review:branch": "node scripts/review/pr-branch-review.mjs",
    "prelint": "pnpm --filter @tracehound/core build",
    "lint": "pnpm -r --filter \"@tracehound/*\" lint && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.5",
      "path-to-regexp": "0.1.13",
      "minimatch": ">=10.2.3",
      "picomatch": ">=4.0.4",
      "rollup": ">=4.59.0",
      "esbuild": ">=0.25.0",
      "flatted": ">=3.4.2"
    }
  }
}
