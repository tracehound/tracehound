{
  "name": "tracehound",
  "version": "1.8.8",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm --filter @tracehound/core build",
    "test": "pnpm -r test",
    "test:fuzz:regression": "vitest run packages/core/tests/fuzz",
    "test:coverage": "vitest run --coverage",
    "test:chaos": "pnpm build && tsx scripts/chaos/run-chaos-suite.ts",
    "verify:release": "node scripts/release/verify-publish-packages.mjs",
    "validate:paranoid": "pnpm lint && pnpm format && pnpm build && pnpm test && pnpm test:fuzz:regression && pnpm test:coverage && pnpm test:chaos && node scripts/release/verify-publish-packages.mjs",
    "review:branch": "node scripts/review/pr-branch-review.mjs",
    "prelint": "pnpm --filter @tracehound/core build",
    "lint": "pnpm -r --filter \"@tracehound/*\" lint && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@tracehound/core": "workspace:^",
    "@tracehound/express": "workspace:^",
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "express": "^4.18.2",
    "prettier": "^3.6.2",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "esbuild": ">=0.25.0",
      "flatted": ">=3.4.2"
    }
  }
}
